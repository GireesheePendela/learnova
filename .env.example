# Copy to .env and edit. Never commit .env.

# bedrock (default, uses the sandbox's AWS credentials) or ollama
MODEL_PROVIDER=bedrock

# Use a model your account has access to (python scripts/list_models.py lists them).
# Leave unset to use the Strands default (a full-size Sonnet model).
# Use a full-size model (e.g. a Sonnet or Opus inference profile), not a Haiku/Lite/Micro one.
# BEDROCK_MODEL_ID=<model-id-from-the-workshop>
# AWS_REGION=us-west-2

# Optional: a different model for one agent, e.g. a larger model for the Content Agent.
# CONTENT_MODEL_ID=<larger-model-id>
# ASSESSMENT_MODEL_ID=
# TUTOR_MODEL_ID=
# Only needed if long Hindi/Arabic quizzes get cut off (MaxTokensReachedException).
# MAX_TOKENS=16000

# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Read-aloud with Amazon Polly: on by default with Bedrock, off with Ollama.
# READ_ALOUD=on

# TEMPERATURE=0.3
# LEARNOVA_DB=learnova.db
