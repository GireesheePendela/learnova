# Copy to .env and edit. Never commit .env.

# bedrock (default, uses the sandbox's AWS credentials) or ollama
MODEL_PROVIDER=bedrock

# Use a model your account has access to (check the workshop instructions).
# Leave unset to use the Strands default.
# Use a full-size model (e.g. a Sonnet or Pro inference profile), not a Haiku/Lite/Micro one.
# BEDROCK_MODEL_ID=<model-id-from-the-workshop>
# AWS_REGION=us-west-2
# Only needed if long Hindi/Arabic quizzes get cut off (MaxTokensReachedException).
# MAX_TOKENS=16000

# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# TEMPERATURE=0.3
# LEARNOVA_DB=learnova.db
